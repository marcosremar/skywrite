// Prisma Schema for Thesis Writer

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?

  // Relations
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ PROJECTS ============

model Project {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?

  // Metadata (from metadata.yaml)
  title      String?
  subtitle   String?
  author     String?
  university String?
  degree     String?
  language   String  @default("pt-BR")

  // Storage
  storageKey String @unique // S3/R2 prefix for project files

  // Settings
  templateId String?
  settings   Json    @default("{}")

  // Relations
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  files  ProjectFile[]
  builds Build[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ProjectFile {
  id        String @id @default(cuid())
  projectId String

  // File info
  path      String   // e.g., "chapters/01-introduction.md"
  name      String   // e.g., "01-introduction.md"
  type      FileType
  mimeType  String?
  sizeBytes Int      @default(0)

  // For text files, store content directly
  content String? @db.Text

  // For media files, store S3/R2 key
  storageKey String?

  // Metadata
  checksum String? // MD5 for change detection

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
}

enum FileType {
  MARKDOWN
  YAML
  BIBTEX
  LATEX
  IMAGE
  PDF
  OTHER
}

// ============ BUILDS ============

model Build {
  id        String @id @default(cuid())
  projectId String

  // Build info
  type   BuildType   @default(FULL)
  status BuildStatus @default(QUEUED)

  // Timing
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  // Output
  pdfUrl       String?
  pdfSizeBytes Int?
  pageCount    Int?

  // Logs and errors
  logs         String? @db.Text
  errorMessage String?
  errorDetails Json?

  // Source snapshot
  sourceHash String? // Hash of source files at build time

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

enum BuildType {
  FULL    // Full PDF build
  PREVIEW // Quick preview (first few pages)
  DRAFT   // Draft mode (faster, less formatting)
}

enum BuildStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ============ TEMPLATES ============

model Template {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String  // e.g., "thesis", "article", "report"

  // Template files stored in S3/R2
  storageKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ PAPER CACHE ============

model Paper {
  id        String @id @default(cuid())
  url       String @unique
  title     String?
  content   String @db.Text
  charCount Int    @default(0)
  source    String @default("pdf")

  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}
